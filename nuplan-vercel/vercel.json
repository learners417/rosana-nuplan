{
  "functions": {
    "api/*.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/public/:path*",
      "destination": "/formulario/index.html"
    },
    {
      "source": "/respaldo-empresas",
      "destination": "/index.html"
    },
    {
      "source": "/respaldo-empresas/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/herramientas/",
      "permanent": false
    },
    {
      "source": "/empresas",
      "destination": "/herramientas/",
      "permanent": false
    },
    {
      "source": "/empresas/:path*",
      "destination": "/herramientas/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/alertas",
      "schedule": "0 12 * * *"
    }
  ]
}
