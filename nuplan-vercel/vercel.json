{
  "functions": {
    "api/*.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/public/:path*",
      "destination": "/formulario/index.html"
    },
    {
      "source": "/respaldo-empresas",
      "destination": "/index.html"
    },
    {
      "source": "/respaldo-empresas/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/herramientas/",
      "permanent": false
    },
    {
      "source": "/empresas",
      "destination": "/herramientas/",
      "permanent": false
    },
    {
      "source": "/empresas/:path*",
      "destination": "/herramientas/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/alertas",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/libro/src/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/libro/img/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/libro/d/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
