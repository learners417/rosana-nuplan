{
  "functions": {
    "api/*.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|herramientas).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/herramientas/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/alertas",
      "schedule": "0 12 * * *"
    }
  ]
}
